pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/SMA-Imp',
                    url: 'https://github.com/cloudwavetechnologies/New-Jenkins-simple-pipeline/'
            }
        }
        stage('Build') {
            steps {
                sh 'echo "Building project..."'
            }
        }
    }
 }
